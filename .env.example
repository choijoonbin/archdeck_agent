# Default is disabled: no network or paid model calls are made by the harness.
ARCHDECK_AGENT_LIVE_ENABLED=false
ARCHDECK_MODEL_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-server-managed-key
# Azure deployment name, not a guessed public model ID.
ARCHDECK_OPENAI_MODEL=replace-with-approved-deployment
ARCHDECK_OPENAI_TIMEOUT_SECONDS=20
ARCHDECK_OPENAI_MAX_OUTPUT_TOKENS=900
# DWP compatibility aliases accepted when the ARCHDECK variables are unset:
# DWP_MODEL_PROVIDER, DWP_OPENAI_BASE_URL, DWP_OPENAI_MODEL,
# DWP_OPENAI_TIMEOUT_SECONDS, DWP_OPENAI_MAX_OUTPUT_TOKENS
